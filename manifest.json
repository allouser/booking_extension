{
  "manifest_version": 3,
  "name": "Allo Booking Exporter",
  "version": "2.3.2",
  "description": "Booking extension for Allo Cabs - copy booking rows, map place names, and trip details directly to Excel.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/config/constants.js",
        "src/config/state.js",
        "src/utils/formatters.js",
        "src/utils/dom.js",
        "src/utils/clipboard.js",
        "src/core/page-detector.js",
        "src/core/table-parser.js",
        "src/core/observer.js",
        "src/features/bulk-queue/cancel.js",
        "src/features/bulk-queue/pagination.js",
        "src/features/detail-extractor/live-extract.js",
        "src/features/detail-extractor/bg-fetch.js",
        "src/features/detail-extractor/detail-banner.js",
        "src/features/floating-panel/panel.js",
        "src/features/row-actions/copy-button.js",
        "src/features/row-actions/checkboxes.js",
        "src/features/snip-tool/snip.js",
        "src/features/maps-poi/poi-detector.js",
        "src/features/bulk-queue/queue.js",
        "src/main.js"
      ],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "commands": {
    "snip_area": {
      "suggested_key": {
        "default": "Alt+S",
        "windows": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Trigger snip selection box on Allo Cabs"
    },
    "copy_all_visible": {
      "suggested_key": {
        "default": "Alt+A",
        "windows": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Copy all visible rows to Excel clipboard"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["poi-page-hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
